# Anthropic API key. Required. Used only server side in app/api/chat/route.ts.
ANTHROPIC_API_KEY=

# Chat model. Defaults to a current Claude Sonnet model if unset.
MERIZA_MODEL=claude-sonnet-4-6

# Optional. Sets Meriza's voice. Defaults to a calm, concise system prompt.
MERIZA_SYSTEM_PROMPT=

# TTS settings. If you want to use TTS, you need to run a TTS server and set the following environment variables.
TTS_BASE_URL=http://localhost:8004/v1
TTS_MODEL=chatterbox
TTS_VOICE=Olivia.wav

STT_BASE_URL=http://localhost:8081